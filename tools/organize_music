#!/usr/bin/env python3

from pathlib import Path
import shutil
import re

from mutagen.flac import FLAC


SOURCE = Path("/workspace/Music/songs")
DESTINATION = Path("/workspace/Music/library")


def clean_name(name):
    """
    Membersihkan karakter yang tidak cocok untuk nama file/folder.
    """
    name = name.strip()

    # Karakter yang bermasalah di nama file
    name = re.sub(r'[<>:"/\\|?*]', '_', name)

    # Hindari titik/spasi di akhir
    name = name.rstrip(" .")

    return name if name else "Unknown"


def get_metadata(file):
    """
    Membaca metadata FLAC.
    """
    audio = FLAC(file)

    artist = audio.get("artist", ["Unknown Artist"])[0]
    album = audio.get("album", ["Unknown Album"])[0]
    title = audio.get("title", [file.stem])[0]

    track = audio.get("tracknumber", [""])[0]

    return (
        clean_name(artist),
        clean_name(album),
        clean_name(title),
        track,
    )


def format_track(track):
    """
    Mengubah track number menjadi 01, 02, 03, dst.
    """
    if not track:
        return "00"

    # Contoh:
    # 1
    # 01
    # 1/12
    match = re.match(r"(\d+)", track)

    if not match:
        return "00"

    number = int(match.group(1))

    return f"{number:02d}"


def main():

    if not SOURCE.exists():
        print(f"Source tidak ditemukan:")
        print(SOURCE)
        return

    DESTINATION.mkdir(parents=True, exist_ok=True)

    flac_files = sorted(SOURCE.rglob("*.flac"))

    if not flac_files:
        print("Tidak ada FLAC ditemukan.")
        return

    print("========================================")
    print("        MUSIC LIBRARY ORGANIZER")
    print("========================================")
    print()
    print(f"Source : {SOURCE}")
    print(f"Target : {DESTINATION}")
    print()
    print(f"Ditemukan {len(flac_files)} FLAC.")
    print()

    copied = 0
    skipped = 0
    errors = 0

    for flac_file in flac_files:

        try:
            artist, album, title, track = get_metadata(flac_file)

            track_number = format_track(track)

            artist_folder = DESTINATION / artist
            album_folder = artist_folder / album

            album_folder.mkdir(
                parents=True,
                exist_ok=True,
            )

            destination_flac = (
                album_folder
                / f"{track_number} - {title}.flac"
            )

            print(f"ARTIST : {artist}")
            print(f"ALBUM  : {album}")
            print(f"TRACK  : {track_number}")
            print(f"TITLE  : {title}")

            # Copy FLAC
            if destination_flac.exists():
                print("  -> SKIP FLAC (sudah ada)")
            else:
                shutil.copy2(
                    flac_file,
                    destination_flac,
                )
                print(f"  -> COPIED: {destination_flac}")

            # Cari LRC dengan nama FLAC asli
            source_lrc = flac_file.with_suffix(".lrc")

            if source_lrc.exists():

                destination_lrc = (
                    album_folder
                    / f"{track_number} - {title}.lrc"
                )

                if destination_lrc.exists():
                    print("  -> SKIP LRC (sudah ada)")
                else:
                    shutil.copy2(
                        source_lrc,
                        destination_lrc,
                    )
                    print(f"  -> LRC: {destination_lrc}")

            else:
                print("  -> NO LRC")

            print()

            copied += 1

        except Exception as error:
            print(f"ERROR: {flac_file.name}")
            print(f"       {error}")
            print()

            errors += 1

    print("========================================")
    print("SELESAI")
    print("========================================")
    print(f"Processed : {copied}")
    print(f"Errors    : {errors}")
    print()
    print(f"Library:")
    print(DESTINATION)


if __name__ == "__main__":
    main()
