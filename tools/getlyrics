#!/usr/bin/env python3

from pathlib import Path

import requests
from mutagen.flac import FLAC


# =========================
# CONFIGURATION
# =========================

MUSIC_FOLDER = Path("/workspace/Music/songs")
LRCLIB_API = "https://lrclib.net/api/get"

REQUEST_TIMEOUT = 10


# =========================
# LRCLIB
# =========================

def get_lyrics(artist: str, title: str):
    """Search synced lyrics from LRCLIB."""

    try:
        response = requests.get(
            LRCLIB_API,
            params={
                "artist_name": artist,
                "track_name": title,
            },
            timeout=REQUEST_TIMEOUT,
        )

        if response.status_code != 200:
            return None

        return response.json()

    except requests.RequestException as error:
        print(f"  -> Network error: {error}")
        return None


# =========================
# PROCESS FLAC
# =========================

def process_folder(folder: Path):
    """Find FLAC files and download synced lyrics."""

    if not folder.exists():
        print(f"Folder tidak ditemukan:")
        print(f"  {folder}")
        return

    flac_files = sorted(folder.rglob("*.flac"))

    if not flac_files:
        print("Tidak ada file FLAC ditemukan.")
        return

    print(f"Ditemukan {len(flac_files)} file FLAC.\n")

    saved = 0
    skipped = 0
    not_found = 0
    no_metadata = 0

    for flac_file in flac_files:

        # LRC menggunakan nama file FLAC yang sama
        lrc_file = flac_file.with_suffix(".lrc")

        # =========================
        # SKIP EXISTING LRC
        # =========================

        if lrc_file.exists():
            print(f"SKIP    {flac_file.name}")
            skipped += 1
            continue

        # =========================
        # READ FLAC METADATA
        # =========================

        try:
            audio = FLAC(flac_file)

            artist = audio.get("artist", [""])[0].strip()
            title = audio.get("title", [""])[0].strip()

        except Exception as error:
            print(f"ERROR   {flac_file.name}")
            print(f"        Tidak bisa membaca metadata: {error}\n")
            continue

        if not artist or not title:
            print(f"NO META {flac_file.name}")
            no_metadata += 1
            continue

        # =========================
        # SEARCH LRCLIB
        # =========================

        print(f"SEARCH  {artist} - {title}")

        result = get_lyrics(artist, title)

        if not result:
            print("  -> Lyrics tidak ditemukan\n")
            not_found += 1
            continue

        # =========================
        # SYNCED LYRICS ONLY
        # =========================

        synced_lyrics = result.get("syncedLyrics")

        if not synced_lyrics:
            print("  -> Synced lyrics tidak tersedia\n")
            not_found += 1
            continue

        # =========================
        # SAVE LRC
        # =========================

        try:
            lrc_file.write_text(
                synced_lyrics,
                encoding="utf-8",
            )

            print(f"  -> SAVED  {lrc_file.name}\n")
            saved += 1

        except OSError as error:
            print(f"  -> Gagal menyimpan LRC: {error}\n")


# =========================
# MAIN
# =========================

def main():
    print("======================================")
    print("       FLAC SYNCED LYRICS DOWNLOADER")
    print("======================================")
    print()
    print(f"Music folder:")
    print(f"  {MUSIC_FOLDER}")
    print()

    process_folder(MUSIC_FOLDER)


if __name__ == "__main__":
    main()
